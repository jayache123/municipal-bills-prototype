# =========================================================================
# Environment variables for local development.
#
# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is gitignored — never commit secrets.
# =========================================================================


# -------------------------------------------------------------------------
# Supabase
# -------------------------------------------------------------------------
# Find these in Supabase: Project Settings → API
#
# - URL:               the "Project URL" (e.g. https://abcd.supabase.co)
# - ANON_KEY:          the "anon public" key (safe to expose to the browser)
# - SERVICE_ROLE_KEY:  the "service_role" key (SECRET — server-side only;
#                      bypasses Row Level Security)
# -------------------------------------------------------------------------

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Same URL and anon key, exposed to the browser by Next.js (the NEXT_PUBLIC_
# prefix makes them available client-side). Safe — RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# -------------------------------------------------------------------------
# Anthropic
# -------------------------------------------------------------------------
# Find this at: https://console.anthropic.com/settings/keys
# The model name itself is stored in the `settings` table, not here.
# -------------------------------------------------------------------------

ANTHROPIC_API_KEY=


# -------------------------------------------------------------------------
# Google Drive (for manual Drive sync — can be left blank until that
# feature is built)
# -------------------------------------------------------------------------
# Paste the entire service account JSON file contents as a single line.
# -------------------------------------------------------------------------

GOOGLE_SERVICE_ACCOUNT_JSON=
